# Copy to .env and fill in. Every service below has a free tier / free plan.
APP_ENV=local
LOG_LEVEL=INFO

# ── LLM ─────────────────────────────────────────────
# gemini | groq | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
JUDGE_PROVIDER=groq
JUDGE_MODEL=llama-3.3-70b-versatile
# https://aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=
# https://console.groq.com/keys (free tier)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings (local, free) ────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
SPARSE_MODEL=prithivida/Splade_PP_en_v1
FASTEMBED_CACHE_PATH=./.models

# ── Vector store: Pinecone Starter (free) ───────────
# pinecone | qdrant | oracle
VECTOR_BACKEND=pinecone
# https://app.pinecone.io -> API Keys
PINECONE_API_KEY=
PINECONE_INDEX=taxlens-dev
# 1 = dense only, 0 = sparse only
HYBRID_ALPHA=0.5

# ── App data ────────────────────────────────────────
# sqlite (local/CI) | cosmos (Azure free tier)
DB_BACKEND=sqlite
SQLITE_PATH=var/taxlens.db
COSMOS_ENDPOINT=
COSMOS_DATABASE=taxlens

# ── Blob + Queue (Azurite well-known dev account — public, local only) ──
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;QueueEndpoint=http://localhost:10001/devstoreaccount1;
BLOB_CONTAINER=documents
INGEST_QUEUE=ingest-jobs
POISON_QUEUE=ingest-poison

# ── Auth ────────────────────────────────────────────
# generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# ── Observability (Phoenix local, LangSmith free Developer plan) ──
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=taxlens
